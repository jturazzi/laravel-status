APP_NAME="Laravel Status"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Paris
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Dashboard: HTTP Basic access (required, otherwise every request is rejected)
STATUS_USERNAME=
STATUS_PASSWORD=

# Shared token sent to the applications (= SYSTEM_INFO_TOKEN on the application side)
STATUS_TOKEN=

# Applications can be added from the /apps page (stored in the database)
# and/or listed here: "Name|https://base-url|optional-token", comma-separated.
# STATUS_APPS="Billing|https://billing.example.com,CRM|https://crm.example.com|crm-token"
STATUS_APPS=

STATUS_TIMEOUT=5
STATUS_CACHE_TTL=30

# Compare with the latest PHP/Laravel releases from php.net and Packagist (cached 6 h).
# false = compare the applications with each other only (no outbound request).
STATUS_UPSTREAM_VERSIONS=true

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
